PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
DATABASE_URL=mysql://USER:PASSWORD@localhost:3306/DATABASE_NAME
# TLS to the database, for the app and for prisma migrate (which gets
# sslaccept=strict and the CA added to its URL). ssl* parameters on DATABASE_URL
# are rejected by prisma commands: configure TLS only with these two settings.
# Required in production. Optional elsewhere (unset = false, plaintext).
#   true    TLS; the server certificate and hostname are always verified
#   false   plaintext; only for a database on localhost or a trusted private network
DATABASE_SSL=false
# Optional, with DATABASE_SSL=true: path to a PEM file (-----BEGIN CERTIFICATE-----)
# with the CA that signed the database certificate, e.g. your provider's CA bundle.
# Unset = Node's built-in public CAs.
DATABASE_SSL_CA=
JWT_ACCESS_SECRET=change_me
JWT_REFRESH_SECRET=change_me_to_a_different_value
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Absolute session lifetime: a login session ends this long after login however
# often it is refreshed (default 30d; at least JWT_REFRESH_EXPIRES_IN). Access
# tokens already issued stay valid up to JWT_ACCESS_EXPIRES_IN longer.
SESSION_ABSOLUTE_EXPIRES_IN=30d
# Optional: defaults to true when NODE_ENV=production
COOKIE_SECURE=
# lax when frontend and API share a site; none (with COOKIE_SECURE=true) when they do not
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=
# Which proxies may set X-Forwarded-For (used for client IPs and rate limits).
# Required in production. Optional elsewhere (unset = false).
#   false                 clients connect to this app directly
#   1                     exactly one proxy/load balancer in front (hop count)
#   10.0.0.5,10.0.0.0/8   the proxy addresses/CIDRs (also: loopback, uniquelocal)
# Never "true" (rejected): it trusts any client-supplied header. Wrong values let
# clients spoof their IP, or make every client share the proxy's rate limit.
TRUST_PROXY=false
# Email for password reset and email verification links. Links point at
# CLIENT_URL (e.g. CLIENT_URL/verify-email?token=...).
# Optional. Unset = console outside production, disabled in production.
#   smtp      real delivery through an SMTP server (settings below)
#   console   prints each email, links included, to the server log (development only; refused in production)
#   disabled  sends nothing; users get no email (failures are logged)
MAIL_PROVIDER=
# SMTP settings, used when MAIL_PROVIDER=smtp. Any SMTP provider works, e.g.
# Resend: SMTP_HOST=smtp.resend.com SMTP_PORT=465 SMTP_USER=resend SMTP_PASS=<API key>
# Brevo:  SMTP_HOST=smtp-relay.brevo.com SMTP_PORT=587 SMTP_USER=<login> SMTP_PASS=<SMTP key>
SMTP_HOST=
# Unset = 587 (STARTTLS required). 465 = implicit TLS.
SMTP_PORT=
# Optional override: "true" = implicit TLS, "false" = no TLS required (local test
# relays only). Unset = implicit TLS on 465, required STARTTLS on other ports.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Sender, on a domain/address verified with the provider.
MAIL_FROM="My Shop <no-reply@shop.example.com>"
# Store name shown in emails. Unset = E-Commerce.
APP_NAME=
# Online payment (Razorpay). Optional: both keys or neither (neither = cash on
# delivery only). Use rzp_test_ keys outside production.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# The secret entered on the webhook in the Razorpay dashboard (POST /api/webhooks/razorpay).
# Required in production when the keys are set; at least 16 characters and never
# the same as RAZORPAY_KEY_SECRET. Unset = the webhook endpoint answers 503.
RAZORPAY_WEBHOOK_SECRET=
# Unpaid online orders hold their stock for 30 minutes; this worker cancels them
# afterwards and returns the stock. Unset/true = on; false = off in this instance
# (keep it on in at least one; several instances at once are safe).
RESERVATION_EXPIRY_WORKER=
# How long past its 30-minute deadline an unpaid online order keeps its stock
# when its only open Razorpay payments are "created" (e.g. a UPI request the
# customer has not approved). Then it is released; a payment captured later is
# a late payment (order reinstated if the stock is there, otherwise refund owed).
# Never applies while a payment is authorized, captured or unrecognised.
# A duration with a unit, 1m to 24h (e.g. 90m, 2h). Unset = 2h.
RESERVATION_CREATED_CUTOFF=
