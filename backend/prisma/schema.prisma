generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ==========================
// Enums
// ==========================

enum Role {
  CUSTOMER
  ADMIN
}

enum AddressType {
  HOME
  WORK
  OTHER
}

enum RefreshTokenRevokeReason {
  ROTATED
  LOGOUT
  REUSE
}

enum UserTokenPurpose {
  PASSWORD_RESET
  EMAIL_VERIFICATION
}

// Payment is tracked separately from fulfilment (OrderStatus). Every order is
// created UNPAID; only server-side Razorpay verification marks one PAID.
enum PaymentStatus {
  UNPAID
  PAID
  FAILED
  REFUNDED
}

// COD: paid on delivery, fulfilled while UNPAID (every order placed before
// online payment existed). RAZORPAY: must be PAID before it can be confirmed.
enum PaymentMethod {
  COD
  RAZORPAY
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

// One value per order/payment event a customer is told about.
enum NotificationType {
  ORDER_PLACED
  PAYMENT_RECEIVED
  ORDER_CONFIRMED
  ORDER_PROCESSING
  ORDER_SHIPPED
  ORDER_DELIVERED
  ORDER_CANCELLED
}

// ==========================
// Users
// ==========================

model User {
  id              Int       @id @default(autoincrement())
  email           String    @unique @db.VarChar(191)
  passwordHash    String    @db.VarChar(255)
  firstName       String    @db.VarChar(100)
  lastName        String    @db.VarChar(100)
  phone           String?   @db.VarChar(30)
  role            Role      @default(CUSTOMER)
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  addresses     Address[]
  cart          Cart?
  orders        Order[]
  refreshTokens RefreshToken[]
  userTokens    UserToken[]
  reviews       Review[]
  notifications Notification[]

  @@map("users")
}

// A message shown to one user. Title and message are stored as written when
// the event happened (like the order snapshot). The client builds the link
// from type + orderId; no URL is stored. dedupeKey (e.g. "order:42:PAID")
// allows one notification per state change, however often it is reported.
// readAt is null while unread.
model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int
  type      NotificationType
  title     String           @db.VarChar(120)
  message   String           @db.VarChar(500)
  orderId   Int?
  dedupeKey String           @unique @db.VarChar(100)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order Order? @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Unread count, and the newest-first list (id breaks ties).
  @@index([userId, readAt])
  @@index([userId, createdAt, id])
  @@index([orderId])
  @@map("notifications")
}

// Single-use links sent by email (password reset, email verification). Only a
// SHA-256 hash of the token is stored; usedAt is set when it is consumed, and
// issuing a new token for a purpose marks the user's older ones used.
model UserToken {
  id        Int              @id @default(autoincrement())
  userId    Int
  purpose   UserTokenPurpose
  tokenHash String           @unique @db.Char(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("user_tokens")
}

// One row per issued refresh token. Only a SHA-256 hash is stored. Tokens
// from one login share a familyId; rotation revokes the old row (ROTATED),
// and presenting a revoked token revokes the whole family (REUSE).
model RefreshToken {
  id               Int                       @id @default(autoincrement())
  userId           Int
  familyId         String                    @db.Char(36)
  tokenHash        String                    @unique @db.Char(64)
  persistent       Boolean                   @default(false)
  // When this token stops working: the earlier of its own inactivity limit
  // and sessionExpiresAt, the session's absolute expiry (set at login and
  // copied unchanged to every token of the session).
  expiresAt        DateTime
  sessionExpiresAt DateTime
  revokedAt        DateTime?
  revokedReason    RefreshTokenRevokeReason?
  createdAt        DateTime                  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model Address {
  id        Int         @id @default(autoincrement())
  userId    Int
  type      AddressType @default(HOME)
  firstName String      @db.VarChar(100)
  lastName  String      @db.VarChar(100)
  phone     String      @db.VarChar(30)
  address   String      @db.VarChar(255)
  apartment String?     @db.VarChar(255)
  city      String      @db.VarChar(100)
  state     String      @db.VarChar(100)
  zipCode   String      @db.VarChar(20)
  country   String      @db.VarChar(100)
  isDefault Boolean     @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

// ==========================
// Catalog
// ==========================

// Top-level categories (Men, Women, ...) have no parent;
// subcategories (T-Shirts, ...) point to their parent.
model Category {
  id          Int      @id @default(autoincrement())
  parentId    Int?
  name        String   @db.VarChar(100)
  slug        String   @unique @db.VarChar(120)
  description String?  @db.Text
  image       String?  @db.VarChar(500)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
  @@map("categories")
}

// `currency` is the currency of every price on the product and its variants.
// It is set when the product is created and never changed afterwards, so a
// stored amount is never reinterpreted in another currency (pricingService).
model Product {
  id            Int      @id @default(autoincrement())
  categoryId    Int
  name          String   @db.VarChar(200)
  slug          String   @unique @db.VarChar(220)
  description   String?  @db.Text
  brand         String?  @db.VarChar(100)
  price         Decimal  @db.Decimal(10, 2)
  originalPrice Decimal? @db.Decimal(10, 2)
  currency      String   @default("USD") @db.Char(3)
  isNew         Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  category   Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants   ProductVariant[]
  images     ProductImage[]
  orderItems OrderItem[]
  reviews    Review[]

  @@index([categoryId])
  @@index([brand])
  @@index([price])
  @@index([createdAt])
  @@map("products")
}

// A purchasable size/color combination of a product.
// `price` overrides Product.price when set.
model ProductVariant {
  id            Int      @id @default(autoincrement())
  productId     Int
  sku           String   @unique @db.VarChar(100)
  size          String?  @db.VarChar(20)
  color         String?  @db.VarChar(50)
  colorHex      String?  @db.VarChar(7)
  price         Decimal? @db.Decimal(10, 2)
  originalPrice Decimal? @db.Decimal(10, 2)
  stock         Int      @default(0) @db.UnsignedInt
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@unique([productId, size, color])
  @@index([productId])
  @@map("product_variants")
}

model ProductImage {
  id        Int      @id @default(autoincrement())
  productId Int
  url       String   @db.VarChar(500)
  altText   String?  @db.VarChar(200)
  position  Int      @default(0)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
  @@map("product_images")
}

// One review per user per product. Verified purchase is derived from
// DELIVERED orders at read time, not stored. The 1-5 rating range is
// enforced by the CHECK constraint `reviews_rating_check` in the migration
// (Prisma cannot express CHECK constraints in the schema).
model Review {
  id        Int      @id @default(autoincrement())
  userId    Int
  productId Int
  rating    Int
  body      String   @db.VarChar(2000)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId, createdAt])
  @@map("reviews")
}

// ==========================
// Cart
// ==========================

model Cart {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        Int      @id @default(autoincrement())
  cartId    Int
  variantId Int
  quantity  Int      @default(1) @db.UnsignedInt
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@index([variantId])
  @@map("cart_items")
}

// ==========================
// Orders
// ==========================

// Totals and the shipping address are copied onto the order
// so later edits to products or addresses do not change history.
model Order {
  id            Int           @id @default(autoincrement())
  orderNumber   String        @unique @db.VarChar(30)
  userId        Int
  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(UNPAID)
  paymentMethod PaymentMethod @default(COD)

  // Razorpay: the gateway order created for this order (one per order, reused
  // on retry) and the captured payment that paid it.
  razorpayOrderId   String?   @unique @db.VarChar(64)
  razorpayPaymentId String?   @unique @db.VarChar(64)
  paidAt            DateTime?

  // Online orders only: the stock taken at checkout is held until this time
  // (server clock, 30 minutes after the order was placed). An order still
  // PENDING and unpaid at or after it is cancelled by the expiry worker,
  // which sets expiredAt and gives the stock back (services/reservationService.js).
  reservationExpiresAt DateTime?
  expiredAt            DateTime?

  subtotal Decimal @db.Decimal(10, 2)
  discount Decimal @default(0) @db.Decimal(10, 2)
  shipping Decimal @default(0) @db.Decimal(10, 2)
  tax      Decimal @default(0) @db.Decimal(10, 2)
  total    Decimal @db.Decimal(10, 2)
  currency String  @default("USD") @db.Char(3)

  shippingFirstName String  @db.VarChar(100)
  shippingLastName  String  @db.VarChar(100)
  shippingPhone     String  @db.VarChar(30)
  shippingEmail     String  @db.VarChar(191)
  shippingAddress   String  @db.VarChar(255)
  shippingApartment String? @db.VarChar(255)
  shippingCity      String  @db.VarChar(100)
  shippingState     String  @db.VarChar(100)
  shippingZipCode   String  @db.VarChar(20)
  shippingCountry   String  @db.VarChar(100)

  deliveryMethod String?   @db.VarChar(50)
  notes          String?   @db.Text
  placedAt       DateTime  @default(now())
  shippedAt      DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  items             OrderItem[]
  unappliedPayments UnappliedPayment[]
  notifications     Notification[]

  @@index([userId, createdAt])
  @@index([status])
  @@index([status, reservationExpiresAt])
  @@map("orders")
}

// A captured Razorpay payment that could not be applied to its order (the
// order was cancelled, already paid by another payment, expired with its
// stock gone, or the amount did not match). The money is with the merchant
// and must be refunded by hand in the Razorpay dashboard; refundedAt is set
// only when Razorpay reports the refund as processed (refund.processed
// webhook), never before. One row per payment, however often it is reported.
model UnappliedPayment {
  id                Int       @id @default(autoincrement())
  orderId           Int
  razorpayPaymentId String    @unique @db.VarChar(64)
  razorpayOrderId   String    @db.VarChar(64)
  // As Razorpay reported it: minor units (cents, paise) and currency.
  amount            Int       @db.UnsignedInt
  currency          String    @db.Char(3)
  reason            String    @db.VarChar(40)
  createdAt         DateTime  @default(now())
  refundedAt        DateTime?
  razorpayRefundId  String?   @unique @db.VarChar(64)

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([refundedAt])
  @@map("unapplied_payments")
}

// Razorpay webhook deliveries already handled, so a redelivery is answered
// without being processed again. eventKey is Razorpay's X-Razorpay-Event-Id
// (the same on every retry of one event), or "sha256:<hash of the body>"
// when that header is missing. A row is written only after the event's
// database changes have committed.
model RazorpayWebhookEvent {
  id                Int      @id @default(autoincrement())
  eventKey          String   @unique @db.VarChar(80)
  event             String   @db.VarChar(64)
  razorpayOrderId   String?  @db.VarChar(64)
  razorpayPaymentId String?  @db.VarChar(64)
  outcome           String   @db.VarChar(40)
  processedAt       DateTime @default(now())

  @@index([razorpayOrderId])
  @@map("razorpay_webhook_events")
}

// Snapshot of what was bought; product/variant links are kept
// when possible but become null if the product is deleted.
model OrderItem {
  id          Int      @id @default(autoincrement())
  orderId     Int
  productId   Int?
  variantId   Int?
  productName String   @db.VarChar(200)
  sku         String   @db.VarChar(100)
  size        String?  @db.VarChar(20)
  color       String?  @db.VarChar(50)
  image       String?  @db.VarChar(500)
  unitPrice   Decimal  @db.Decimal(10, 2)
  quantity    Int      @db.UnsignedInt
  lineTotal   Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@map("order_items")
}
